# Intentionally contains names only. Never commit secret values.
X1_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
MCP_GATEWAY_URL=

# Universal Worker Fabric v1 identity (non-secret identifiers/digests only).
# The credential VALUE is never stored here. X1_WORKER_CREDENTIAL_ID is only an opaque registry identifier.
X1_WORKER_ID=
X1_WORKER_IDENTITY_VERSION=
X1_WORKER_ARTIFACT_DIGEST=
X1_WORKER_CREDENTIAL_ID=
